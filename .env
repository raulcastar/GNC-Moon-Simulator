# Which rover the GNC stack drives. Unreal must run the matching level:
#   leo_raph   Lunar_Terrain_1      (Leo_Raph, 4 wheels)
#   yutu       Lunar_Terrain_Yutu   (Yutu, 6 wheels; model by tashtego, CC-BY-4.0)
# Switch: edit this line, then `docker compose up -d` (recreates the four containers
# that use it: rover, planner, robot description, dashboard).
GNC_ROVER=yutu
